#!/bin/bash
#
# docker shim.
#
# The runner shells out to `docker` by name, and this is earlier on PATH than
# the real client, so this runs first and then hands off to it. There is no
# engine in this container: both clients talk to the *host* user's engine over
# the socket the Quadlet mounts at /var/run/docker.sock.
#
# Three jobs, in order:
#
#   1. Strip the hardcoded `-v /var/run/docker.sock:/var/run/docker.sock`.
#      It lives in ContainerOperationProvider, which is compiled, so it cannot
#      be patched out upstream. This shim is the whole reason for the design.
#   2. Label job containers so the pruner can identify what it owns by
#      positive selection rather than by reaping everything that is not a
#      runner.
#   3. Apply JOB_MEMORY_MAX / JOB_CPUS. This is the only point in the
#      architecture with a job container's command line in hand — the runner
#      unit's MemoryMax does not reach a sibling container. See design §7.2.
#
# Everything else passes through untouched, to the *real* Docker CLI. Podman's
# socket serves a Docker-compatible API alongside its own, so the genuine
# client works against it -- which is what makes `docker buildx` work, podman's
# own buildx being a stub that rejects `create --name`.

set -uo pipefail

SOCK_PATH="${GH_RUNNER_SOCK_PATH:-/var/run/docker.sock}"

# Absolute, and never resolved through PATH.
#
# This script IS /usr/local/bin/docker, and /usr/local/bin precedes /usr/bin,
# so `exec docker` would re-invoke the shim forever. That failure presents as
# the runner hanging or the box running out of processes -- nothing that names
# this file -- so the path is hardcoded and checked below rather than trusted.
ENGINE="${GH_RUNNER_ENGINE:-/usr/bin/docker}"

case "$(readlink -f "$ENGINE" 2>/dev/null || echo "$ENGINE")" in
    "$(readlink -f "$0" 2>/dev/null || echo "$0")")
        echo "docker shim: GH_RUNNER_ENGINE points back at the shim ($ENGINE)." >&2
        echo "That is an infinite loop. It must be the real client." >&2
        exit 1
        ;;
esac

# 1 = drop the socket mount (default). 0 = rewrite it, for a workflow that
# genuinely needs socket access inside the job container.
DROP_SOCKET="${GH_RUNNER_SHIM_DROP_SOCKET:-1}"

# Two clients, two variables, one socket. The Docker CLI reads DOCKER_HOST and
# podman-remote reads CONTAINER_HOST; defaulting both here means a hand-run
# `docker` inside the container behaves exactly like one the runner invokes.
export DOCKER_HOST="${DOCKER_HOST:-unix://${SOCK_PATH}}"
export CONTAINER_HOST="${CONTAINER_HOST:-unix://${SOCK_PATH}}"

# Subcommand groups whose real verb is the *second* positional.
# Not named GROUPS: that is a bash special variable holding the caller's
# group ids, and assigning to it does not stick.
VERB_GROUPS=" network volume image system container pod secret manifest "

is_sock_spec() {
    case "$1" in
        "${SOCK_PATH}:"*|"${SOCK_PATH}") return 0 ;;
        *"source=${SOCK_PATH},"*|*"src=${SOCK_PATH},"*) return 0 ;;
        *"source=${SOCK_PATH}"|*"src=${SOCK_PATH}") return 0 ;;
        *) return 1 ;;
    esac
}

out=()
pos=0
depth=1
verb=""
sub=""
insert_at=-1

# The subcommand chain is read only from *leading* positionals, before any
# flag. Without that restriction a flag's value gets miscounted as a verb:
# in `network create --driver bridge foo`, "bridge" is the value of --driver,
# and treating it as the second positional puts the injection in the wrong
# place. Real invocations always lead with the verb chain.
seen_flag=0

while (( $# )); do
    arg="$1"
    case "$arg" in
        -v|--volume|--mount)
            seen_flag=1
            if (( $# < 2 )); then out+=("$arg"); shift; continue; fi
            if [[ $DROP_SOCKET == 1 ]] && is_sock_spec "$2"; then shift 2; continue; fi
            out+=("$arg" "$2"); shift 2
            ;;
        --volume=*|--mount=*)
            seen_flag=1
            if [[ $DROP_SOCKET == 1 ]] && is_sock_spec "${arg#*=}"; then shift; continue; fi
            out+=("$arg"); shift
            ;;
        -*)
            seen_flag=1
            out+=("$arg"); shift
            ;;
        *)
            if (( seen_flag == 0 )); then
                pos=$((pos + 1))
                if (( pos == 1 )); then
                    verb="$arg"
                    case "$VERB_GROUPS" in *" $arg "*) depth=2 ;; esac
                elif (( pos == 2 )); then
                    sub="$arg"
                fi
            fi
            out+=("$arg")
            # Injection goes immediately after the subcommand chain, where
            # flags are still legal and cannot be mistaken for the image name
            # or the command being run inside it. Never reorder anything else.
            if (( seen_flag == 0 && pos == depth && insert_at < 0 )); then
                insert_at=${#out[@]}
            fi
            shift
            ;;
    esac
done

# A global flag before the verb (docker --config /x network create ...) leaves
# insert_at unset, so we pass through unmodified rather than guess. The runner
# has not been observed to emit that form.

if (( insert_at < 0 )); then
    exec "$ENGINE" "${out[@]}"
fi

action="$verb"
group=""
if (( depth == 2 )); then
    action="$sub"
    group="$verb"
fi

inject=()
case "$group:$action" in
    ":create"|":run"|"container:create"|"container:run"|"network:create"|"volume:create")
        inject+=(--label "net.preoccupied.gh-runner.role=job")
        if [[ -n ${RUNNER_ID:-} ]]; then
            inject+=(--label "net.preoccupied.gh-runner.id=${RUNNER_ID}")
        fi
        ;;
esac

case "$group:$action" in
    ":create"|":run"|"container:create"|"container:run")
        if [[ -n ${JOB_MEMORY_MAX:-} ]]; then inject+=("--memory=${JOB_MEMORY_MAX}"); fi
        if [[ -n ${JOB_CPUS:-} ]];       then inject+=("--cpus=${JOB_CPUS}"); fi
        ;;
esac

if (( ${#inject[@]} == 0 )); then
    exec "$ENGINE" "${out[@]}"
fi

exec "$ENGINE" "${out[@]:0:insert_at}" "${inject[@]}" "${out[@]:insert_at}"

# On `buildx`: nothing to do, and that is deliberate rather than incidental.
# `buildx` is not in VERB_GROUPS, so it parses as a depth-1 verb whose action
# is "buildx" -- matching neither create nor run -- and passes straight through
# for the real CLI to dispatch to its plugin.
#
# Do not add it to VERB_GROUPS. `docker buildx build` would then receive
# --label, and --label on a *build* labels the resulting image, quietly
# stamping role=job onto everything you publish.
#
# Note also that buildx speaks to the API directly rather than shelling out, so
# the buildkitd container it spawns never passes through here: no labels, no
# JOB_MEMORY_MAX. gh-runner-prune matches those by name instead.
