# Build environment for producing the RPM.
#
# Everything the build needs is installed here, once, at image build time.
# tools/rpmbuild.sh installs nothing: it assembles sources and calls rpmbuild.


ARG BASE=docker.io/library/almalinux:10
FROM ${BASE}

# CRB carries some of the -devel and macro packages on EL. Tolerated where it
# does not exist, so a Fedora base still works.
RUN dnf -y install dnf-plugins-core \
    && (dnf config-manager --set-enabled crb 2>/dev/null \
        || dnf config-manager --enable crb 2>/dev/null \
        || echo "no crb repo on this base, continuing") \
    && dnf -y install \
         rpm-build \
         rpmdevtools \
         git-core \
         curl \
         ca-certificates \
         tar \
         gzip \
         xz \
         zstd \
         python3-devel \
         python3-setuptools \
         python3-wheel \
         python3-pip \
         pyproject-rpm-macros \
         systemd-rpm-macros \
    && dnf clean all

WORKDIR /work


# The end.
